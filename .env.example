# ─── Database ────────────────────────────────────────────────────────────────
# Pooled connection (used at runtime via PrismaPg adapter)
DATABASE_URL=
# Direct connection (used for migrations)
DIRECT_URL=

# ─── NextAuth v5 ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=i9kIOklxM2n/bGeIr6Yh/tvF0cmKSXogXMeZPOYeVdA=

# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=deliveries
NEXT_PUBLIC_SUPABASE_BUCKET=deliveries

# ─── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=Approve Falcon <noreply@yourdomain.com>

# ─── App URL ─────────────────────────────────────────────────────────────────
# Full public URL of your deployment — no trailing slash
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# ─── Groq (AI-assisted spreadsheet column mapping) ───────────────────────────
# Optional — only used as a fallback when a content-plan spreadsheet import
# has columns the deterministic header matcher doesn't recognize.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b


