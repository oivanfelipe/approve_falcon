// This is your Prisma schema file
// Prisma 7 — connection URLs moved to prisma.config.ts
// Learn more: https://pris.ly/d/prisma7-client-config

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    schemas  = ["falcon"]
}

// ─── NextAuth required models ────────────────────────────────────────────────

model User {
    @@schema("falcon")
    id            String    @id @default(cuid())
    name          String?
    email         String    @unique
    emailVerified DateTime?
    image         String?
    password      String? // hashed — null for OAuth users
    locale        String    @default("pt") // "pt" or "en" — detected from browser
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt

    accounts     Account[]
    sessions     Session[]
    projects     Project[]
    freelancerSettings FreelancerSettings?

    teamMembershipsAsOwner  TeamMembership[] @relation("TeamOwnerMemberships")
    teamMembershipsAsMember TeamMembership[] @relation("TeamUserMemberships")
    teamInvitesSent         TeamInvite[]     @relation("TeamOwnerInvites")
}

model Account {
    @@schema("falcon")
    id                String   @id @default(cuid())
    userId            String
    type              String
    provider          String
    providerAccountId String
    refresh_token     String?  @db.Text
    access_token      String?  @db.Text
    expires_at        Int?
    token_type        String?
    scope             String?
    id_token          String?  @db.Text
    session_state     String?
    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([provider, providerAccountId])
}

model Session {
    @@schema("falcon")
    id           String   @id @default(cuid())
    sessionToken String   @unique
    userId       String
    expires      DateTime
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
    @@schema("falcon")
    identifier String
    token      String
    expires    DateTime

    @@unique([identifier, token])
}

// ─── Approve Falcon domain models ────────────────────────────────────────────

model Project {
    @@schema("falcon")
    id            String   @id @default(cuid())
    userId        String
    name          String
    clientName    String
    clientEmail   String?
    description   String?
    calendarToken String?  @unique // public token for the shareable content-calendar link
    clientLogoUrl String? // Supabase Storage path — client's own logo, used in post mockups
    primaryColor  String? // hex — overrides the freelancer's own brand color for this client's mockups
    secondaryColor String?
    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt

    user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
    deliveries Delivery[]
}

model Delivery {
    @@schema("falcon")
    id            String         @id @default(cuid())
    projectId     String
    versionNumber Int
    label         String? // e.g. "Color adjustments"
    scheduledAt   DateTime? // publish date shown on the project's content calendar — null until the team assigns a day
    planNumber    String? // "Nº" from the content-plan spreadsheet (e.g. "01")
    theme         String? // "Tema"
    format        String? // "Formato" — Carrossel, Estático, Reels, etc.
    product       String? // "Produto" — optional product/line this post is about
    objective     String? @db.Text // "Objetivo / Pilar"
    postFunction  String? // "Função" — the post's role in the strategy, e.g. "Institucional", "Lançamento do perfil"
    artCopy       String? @db.Text // "Copy da arte" — script/text that goes inside the creative, for the designer
    copyText      String? // "Legenda e CTA" — approved before the creative is revealed
    copyStatus    DeliveryStatus @default(PENDING)
    sourceType    DeliverySource @default(FILE)
    filePath      String? // Supabase Storage path — null when sourceType is DRIVE_LINK
    fileName      String? // null until the creative file/link is attached (e.g. right after a spreadsheet import)
    fileSize      Int? // bytes — null when sourceType is DRIVE_LINK
    mimeType      String? // null when sourceType is DRIVE_LINK
    driveUrl      String? // Google Drive share link — set when sourceType is DRIVE_LINK
    reviewToken   String         @unique
    status        DeliveryStatus @default(PENDING) // creative approval — gated behind copyStatus === APPROVED
    expiresAt     DateTime?
    requiresEmail Boolean        @default(false)
    allowDownload Boolean        @default(true)
    password      String? // optional link password (hashed)
    createdAt     DateTime       @default(now())
    updatedAt     DateTime       @updatedAt

    project               Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
    comments             Comment[]
    views                View[]
    approval             Approval?
    chatNotificationState ChatNotificationState?
    assets                DeliveryAsset[]
}

// Extra carousel slides beyond the delivery's own primary file/link —
// "lâmina 2", "lâmina 3"... each with its own image or Drive link.
model DeliveryAsset {
    @@schema("falcon")
    id         String         @id @default(cuid())
    deliveryId String
    position   Int // display order among the extra slides, starting at 0
    sourceType DeliverySource @default(FILE)
    filePath   String? // Supabase Storage path — null when sourceType is DRIVE_LINK
    fileName   String?
    fileSize   Int?
    mimeType   String?
    driveUrl   String?
    createdAt  DateTime       @default(now())

    delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

    @@index([deliveryId])
}

model ChatNotificationState {
    @@schema("falcon")
    id                     String    @id @default(cuid())
    deliveryId             String    @unique
    hasPendingNotification Boolean   @default(false)
    unreadCount            Int       @default(0)
    lastNotifiedAt         DateTime?
    createdAt              DateTime  @default(now())
    updatedAt              DateTime  @updatedAt

    delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
}

model Comment {
    @@schema("falcon")
    id          String     @id @default(cuid())
    deliveryId  String
    parentId    String?
    authorType  AuthorType
    authorName  String
    authorEmail String?
    content     String     @db.Text
    audioUrl    String?
    // Normalized image coordinates (0–1). null = general comment
    xPosition   Float?
    yPosition   Float?
    resolvedAt  DateTime?
    createdAt   DateTime   @default(now())

    delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
    parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
    replies  Comment[] @relation("CommentReplies")
}

model View {
    @@schema("falcon")
    id         String   @id @default(cuid())
    deliveryId String
    ipAddress  String?
    userAgent  String?
    createdAt  DateTime @default(now())

    delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
}

model Approval {
    @@schema("falcon")
    id          String   @id @default(cuid())
    deliveryId  String   @unique
    signerName  String
    signerEmail String?
    ipAddress   String?
    createdAt   DateTime @default(now())

    delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
}

model FreelancerSettings {
    @@schema("falcon")
    id             String   @id @default(cuid())
    userId         String   @unique
    displayName    String?
    logoUrl        String?
    primaryColor   String   @default("#E10600")
    secondaryColor String   @default("#000000")
    backgroundColor String?
    slug           String   @unique
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TeamMembership {
    @@schema("falcon")
    id        String   @id @default(cuid())
    ownerId   String // the organization: the account owner's User.id
    userId    String // the team member's own login
    role      TeamRole @default(EDITOR)
    createdAt DateTime @default(now())

    owner User @relation("TeamOwnerMemberships", fields: [ownerId], references: [id], onDelete: Cascade)
    user  User @relation("TeamUserMemberships", fields: [userId], references: [id], onDelete: Cascade)

    @@unique([ownerId, userId])
}

model TeamInvite {
    @@schema("falcon")
    id        String           @id @default(cuid())
    ownerId   String
    email     String
    role      TeamRole         @default(EDITOR)
    token     String           @unique
    status    TeamInviteStatus @default(PENDING)
    createdAt DateTime         @default(now())
    expiresAt DateTime?

    owner User @relation("TeamOwnerInvites", fields: [ownerId], references: [id], onDelete: Cascade)

    @@unique([ownerId, email])
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum DeliveryStatus {
    @@schema("falcon")
    PENDING
    APPROVED
    CHANGES_REQUESTED
}

enum DeliverySource {
    @@schema("falcon")
    FILE
    DRIVE_LINK
}

enum AuthorType {
    @@schema("falcon")
    CLIENT
    FREELANCER
}

enum TeamRole {
    @@schema("falcon")
    ADMIN
    EDITOR
}

enum TeamInviteStatus {
    @@schema("falcon")
    PENDING
    ACCEPTED
    REVOKED
}

// ─── Guest (anonymous) uploads ───────────────────────────────────────────────

model GuestUpload {
    @@schema("falcon")
    id              String         @id @default(cuid())
    filePath        String
    fileName        String
    fileSize        Int
    mimeType        String
    reviewToken     String         @unique
    claimToken      String         @unique
    status          DeliveryStatus @default(PENDING)
    expiresAt       DateTime
    claimedByUserId String?
    createdAt       DateTime       @default(now())

    comments GuestComment[]
    views    GuestView[]
}

model GuestComment {
    @@schema("falcon")
    id            String     @id @default(cuid())
    guestUploadId String
    parentId      String?
    authorType    AuthorType @default(CLIENT)
    authorName    String
    content       String     @db.Text
    audioUrl      String?
    xPosition     Float?
    yPosition     Float?
    resolvedAt    DateTime?
    createdAt     DateTime   @default(now())

    guestUpload GuestUpload @relation(fields: [guestUploadId], references: [id], onDelete: Cascade)
    parent      GuestComment?  @relation("GuestCommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
    replies     GuestComment[] @relation("GuestCommentReplies")
}

model GuestView {
    @@schema("falcon")
    id            String   @id @default(cuid())
    guestUploadId String
    ipAddress     String?
    userAgent     String?
    createdAt     DateTime @default(now())

    guestUpload GuestUpload @relation(fields: [guestUploadId], references: [id], onDelete: Cascade)
}
